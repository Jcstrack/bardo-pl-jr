# Rutas a archivos secretos; no escribas los tokens en este archivo.
BOT_TOKEN_FILE=C:/ruta/privada/bot-token
LIBRARY_EDITOR_KEY_FILE=C:/ruta/privada/library-editor-key
LIBRARY_DATA_DIR=C:/ruta/local/bardo-data
# Start-QuickTunnel.ps1 completa esta dirección temporal automáticamente.
BARDO_PUBLIC_URL=
# Client ID público de Spotify, si usas su integración OAuth.
VITE_SPOTIFY_CLIENT_ID=
