{
  "manifest_version": 3,
  "name": "Bardo · Control de pestañas",
  "version": "0.2.3",
  "description": "Conecta la pestaña que reproduce audio con el reproductor Bardo.",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": ["http://localhost/*", "https://*.trycloudflare.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["http://localhost/*", "https://*.trycloudflare.com/*"],
    "js": ["bridge.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_popup": "popup.html", "default_title": "Conectar pestaña a Bardo" }
}
